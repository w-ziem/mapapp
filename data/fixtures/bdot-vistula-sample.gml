<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic minimal BDOT10k fixture for focused parser tests; not an official download. -->
<wfs:FeatureCollection
  xmlns:wfs="http://www.opengis.net/wfs/2.0"
  xmlns:gml="http://www.opengis.net/gml/3.2"
  xmlns:ot="urn:gugik:specyfikacje:gmlas:bdot10k:1.0">
  <wfs:member>
    <ot:OT_SWRS_L gml:id="river.vistula.test">
      <ot:nazwaGeograficzna>Wisła</ot:nazwaGeograficzna>
      <ot:geometria>
        <gml:LineString srsName="urn:ogc:def:crs:EPSG::4326">
          <gml:posList>49.60 19.00 50.06 19.94 52.23 21.01 54.35 18.65</gml:posList>
        </gml:LineString>
      </ot:geometria>
    </ot:OT_SWRS_L>
  </wfs:member>
</wfs:FeatureCollection>
